    {
      "id": "l2pvsg464-oMJ7Jnvrr8u",
      "type": "text",
      "x": 1746.6509496445979,
      "y": 982.4163654670165,
      "width": 674.7401123046875,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3B",
      "roundness": null,
      "seed": 364473468,
      "version": 305,
      "versionNonce": 1715540164,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790628564768,
      "created": 1790626016668,
      "link": null,
      "locked": false,
      "text": "1 лабораторная - интерфейсы для вашей бд. Интерфейсы для классов,\nтаким образом мы задаем скелет нашей программы.\n\n2 лабораторная - реализация интерфейсов. На этом этапе мы\nдолжны получить локально работающую бд.\n\n3 лабораторная - разворачиваем бд на хосте. После этого этапа в\nнашу бд должна быть возможность ходить через grpc или rest (или\nдругой rpc).\n\n4 и 5 лабораторная - репликация и шардирование в любом порядке.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 лабораторная - интерфейсы для вашей бд. Интерфейсы для классов, таким образом мы задаем скелет нашей программы.\n\n2 лабораторная - реализация интерфейсов. На этом этапе мы должны получить локально работающую бд.\n\n3 лабораторная - разворачиваем бд на хосте. После этого этапа в нашу бд должна быть возможность ходить через grpc или rest (или другой rpc).\n\n4 и 5 лабораторная - репликация и шардирование в любом порядке.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
