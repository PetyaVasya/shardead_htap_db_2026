      "text": "Технологии:\n- Kotlin\n- Gradle",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Технологии:\n- Kotlin\n- Gradle",
